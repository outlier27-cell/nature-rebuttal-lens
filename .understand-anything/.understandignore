# .understandignore - patterns for Understand-Anything analysis
# Keep source, docs, tests, config, examples, and release artifacts in scope.

# Local/generated dependency and cache directories
.git/
.codegraph/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Large binary/source documents are represented by derived docs in the graph.
*.pdf
*.doc
*.docx

# Local secrets and runtime output
.env
.env.*
*.log
*.tmp
tmp/
